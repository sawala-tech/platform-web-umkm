Options -Indexes

# Arahkan semua permintaan ke folder public/ (tanpa mengubah URL di browser),
# sehingga aplikasi bisa diakses langsung dari root, mis. http://localhost/platform-web-umkm/
# Folder lain (src/, config/, database/, .git, dst.) otomatis tidak bisa diakses langsung.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
